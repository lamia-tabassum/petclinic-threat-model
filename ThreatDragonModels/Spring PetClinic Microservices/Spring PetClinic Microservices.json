  "summary": {
    "title": "Spring PetClinic Microservices",
    "owner": "Lamia Tabassum",
    "description": "Spring PetClinic is a microservices-based veterinary clinic application. This preliminary threat model focuses on the Customers, Vets, and Visits services, including communication through the API Gateway and interactions with their data stores. The objective is to identify potential security threats using STRIDE, examine relevant trust boundaries, and document possible mitigations. All identified threats are preliminary hypotheses pending source-code analysis and validation.",
    "id": 0
  },
